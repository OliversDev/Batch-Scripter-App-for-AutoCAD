<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="Batch Scripter"
                    Description="Run an AutoCAD script across an ordered list of drawing files."
                    AppVersion="2.0.0"
                    FriendlyVersion="2.0.0"
                    Author="Oliver Wackenreuther"
                    AppNameSpace="com.oliversdev.batchscripter"
                    ProductCode="{5CFE1D71-E7B6-4F96-A8AE-8F7D5DB51364}"
                    UpgradeCode="{79B2CE28-AB4E-4B65-B056-4593FDF36CD8}"
                    Icon="./Contents/Resources/BatchScripter.ico"
                    Helpfile="./Contents/Help/index.html"
                    OnlineDocumentation="https://github.com/OliversDev/Batch-Scripter-App-for-AutoCAD">
  <CompanyDetails Name="Oliver Wackenreuther"
                  Url="https://github.com/OliversDev" />

  <!-- AutoCAD 2026 uses the .NET 8 build. -->
  <Components Description="AutoCAD 2026">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R25.1" SeriesMax="R25.1" />
    <ComponentEntry AppName="Batch Scripter Ribbon 2026"
                    ModuleName="./Contents/Resources/BatchScripter.cuix"
                    AppDescription="Batch Scripter ribbon panel for AutoCAD 2026"
                    LoadOnAutoCADStartup="True" />
    <ComponentEntry AppName="Batch Scripter 2026"
                    ModuleName="./Contents/2026/Batch Scripter App for AutoCAD.dll"
                    AppDescription="Batch Scripter for AutoCAD 2026"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="BatchScripter">
        <Command Global="OW:BatchScripter" Local="OW:BatchScripter" />
      </Commands>
    </ComponentEntry>
  </Components>

  <!-- AutoCAD 2027 uses the .NET 10 build. -->
  <Components Description="AutoCAD 2027">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD" SeriesMin="R26.0" SeriesMax="R26.0" />
    <ComponentEntry AppName="Batch Scripter Ribbon 2027"
                    ModuleName="./Contents/Resources/BatchScripter.cuix"
                    AppDescription="Batch Scripter ribbon panel for AutoCAD 2027"
                    LoadOnAutoCADStartup="True" />
    <ComponentEntry AppName="Batch Scripter 2027"
                    ModuleName="./Contents/2027/Batch Scripter App for AutoCAD.dll"
                    AppDescription="Batch Scripter for AutoCAD 2027"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="BatchScripter">
        <Command Global="OW:BatchScripter" Local="OW:BatchScripter" />
      </Commands>
    </ComponentEntry>
  </Components>

</ApplicationPackage>
